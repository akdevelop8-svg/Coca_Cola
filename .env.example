# ==============================================================================
# APPLICATION RUNTIME & COMPLIANCE FLAGS
# ==============================================================================
# Server port (must be 3000 in AI Studio preview)
PORT=3000

# Hosting URL where the applet is served (injected automatically by AI Studio)
APP_URL="MY_APP_URL"

# Custom production domain for referral links (e.g., https://yourdomain.com)
PUBLIC_SITE_URL=""

# Sandbox mode keeps all financial transactions in the sandbox database without live payment gateways
SANDBOX_MODE=true

# Must remain false until legal, financial, and payment-provider compliance approval is complete
COMPLIANCE_APPROVED=false

# ==============================================================================
# BACKEND SECURITY & STORAGE (SERVER-ONLY — NEVER EXPOSE TO FRONTEND)
# ==============================================================================
# Secret key used to sign/verify server sessions (set a strong random string in production)
SESSION_SECRET=""

# Admin sign-in credentials (server-side secrets only; never hardcode or prefix with VITE_)
ADMIN_PHONE="+25190909090"
ADMIN_USERNAME=""
ADMIN_PASSWORD=""

# SQLite database file path (server-side only)
DB_PATH="./data/platform.sqlite"

# Private upload directory for payment receipts and ticket attachments (server-side only)
UPLOAD_DIR="./data/uploads"

# Optional Gemini API Key (server-side only, if AI features are later enabled)
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# ==============================================================================
# OPTIONAL FUTURE SUPABASE INTEGRATION (IF MIGRATING FROM SANDBOX SQLITE)
# ==============================================================================
# Frontend-safe public variables (must use VITE_ prefix)
# VITE_SUPABASE_URL=""
# VITE_SUPABASE_ANON_KEY=""
#
# Backend-only secret key (NEVER prefix with VITE_ or expose in frontend code)
# SUPABASE_SERVICE_ROLE_KEY=""
